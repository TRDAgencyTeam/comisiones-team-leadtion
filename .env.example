# Variables de entorno para la app de Comisiones CS.
# Copia este archivo a `.env` (git-ignorado) y complétalo con los valores de tu
# proyecto Supabase. NUNCA subas `.env` al repositorio.

# --- Supabase / Postgres ---
# Cadena de conexión de Postgres. En serverless (Vercel) usa el POOLER de Supabase
# (Project Settings -> Database -> Connection string -> "Transaction pooler").
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres

# API de Supabase (Project Settings -> API)
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...           # público, para el cliente autenticado
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # SECRETO, solo en servidor (Vercel)
