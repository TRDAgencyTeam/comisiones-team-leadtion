{
  "name": "comisiones-cs-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Motor de reglas de comisión CS (LEADTION) — Fase 2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "reporte": "node --experimental-sqlite --import tsx src/cli.ts",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:verify": "node --import tsx scripts/verify-postgres.mjs",
    "seed:export": "node --experimental-sqlite scripts/export-seed.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
